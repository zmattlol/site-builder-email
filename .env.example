PORT=3000

# SMTP settings used to send outreach emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Your Name <you@example.com>"

# Optional default values pre-filled in the dashboard
DEFAULT_SENDER_NAME=Your Name
DEFAULT_SENDER_COMPANY=Your Web Studio
DEFAULT_OFFER_SUMMARY=I build and set up personalized websites for local businesses to help convert profile visitors into paying customers.
DEFAULT_CTA_LINE=If this is something you would be open to, I can share a simple website plan for your business.
